{
  "manifest_version": 3,
  "name": "QR Region Scanner",
  "version": "0.1.0",
  "version_name": "0.1.0 alpha",
  "description": "Drag a box over a QR code on any webpage to read it.",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QR Region Scanner",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "commands": {
    "scan": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Scan a QR code in a selected area"
    }
  }
}
